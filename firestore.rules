rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if user has teacher or admin role
    function isTeacherOrAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'teacher' || getUserData().role == 'admin' || getUserData().role == 'teacher-admin');
    }

    // Match users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow creation of user profile if authenticated as that user, but force role to be empty or default student
      allow create: if isAuthenticated() && request.auth.uid == userId 
        && (!('role' in request.resource.data) || request.resource.data.role == 'student' || request.resource.data.role == '')
        && (!('approved' in request.resource.data) || request.resource.data.approved == false);
      // Allow updates to safe fields (displayName, avatarUrl, studentClass) but block editing role/approved unless teacher/admin
      allow update: if isAuthenticated() && (
        isTeacherOrAdmin() || (
          request.auth.uid == userId 
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved']))
        )
      );
      allow delete: if isTeacherOrAdmin();
    }

    // Match classes and study data
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
      
      // Subcollection inside classes for student star tracking/rewards
      match /students/{studentId} {
        allow read: if isAuthenticated();
        allow write: if isTeacherOrAdmin();
      }
    }

    // Match lesson configurations and status (e.g. locks)
    match /lessons/{lessonId} {
      allow read: if true; // Publicly readable for students to study
      allow write: if isTeacherOrAdmin();
    }

    // Match student exercise submissions
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isTeacherOrAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isTeacherOrAdmin();
    }
  }
}
