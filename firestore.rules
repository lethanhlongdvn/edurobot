rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if user has teacher or admin role
    function isTeacherOrAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'teacher' || getUserData().role == 'admin' || getUserData().role == 'teacher-admin');
    }

    // Match users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow creation of user profile if authenticated as that user, but force role to be empty or default student
      allow create: if isAuthenticated() && request.auth.uid == userId 
        && (!('role' in request.resource.data) || request.resource.data.role == 'student' || request.resource.data.role == '')
        && (!('approved' in request.resource.data) || request.resource.data.approved == false);
      // Allow updates to safe fields (displayName, avatarUrl, studentClass) but block editing role/approved unless teacher/admin
      allow update: if isAuthenticated() && (
        isTeacherOrAdmin() || (
          request.auth.uid == userId 
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved']))
        )
      );
      allow delete: if isTeacherOrAdmin();
    }

    // Match classes and study data
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
      
      // Subcollection inside classes for student star tracking/rewards
      match /students/{studentId} {
        allow read: if isAuthenticated();
        allow write: if isTeacherOrAdmin();
      }
    }

    // Match lesson configurations and status (e.g. locks)
    match /lessons/{lessonId} {
      allow read: if true; // Publicly readable for students to study
      allow write: if isTeacherOrAdmin();
    }

    // Match student exercise submissions
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isTeacherOrAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isTeacherOrAdmin();
    }

    // Match app_settings (content locks, etc.)
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin();
    }

    // Match stars tracking collection
    match /stars/{email} {
      allow read: if true;
      allow write: if isTeacherOrAdmin() || (isAuthenticated() && request.auth.token.email.toLowerCase() == email.toLowerCase());
    }

    // Match score and learning progress (diem_tieng_viet_lop5)
    match /diem_tieng_viet_lop5/{docId} {
      // Allow student to read/write their own records, and teachers to manage all
      allow read, write: if isTeacherOrAdmin() || (isAuthenticated() && (
        docId.startsWith(request.auth.uid) || 
        (resource != null && resource.data.uid == request.auth.uid) ||
        (request.resource != null && request.resource.data.uid == request.auth.uid)
      ));
    }

    // Match essays / AI graded exercises (essays_v2)
    match /essays_v2/{docId} {
      allow read: if isAuthenticated() && (isTeacherOrAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (isTeacherOrAdmin() || resource.data.uid == request.auth.uid);
      allow delete: if isTeacherOrAdmin();
    }

    // Match active class selection (lop5chon)
    match /lop5chon/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }

    // Match custom game sessions
    match /game_sessions/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isTeacherOrAdmin() || (isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        !('ownerUid' in resource.data)
      ));
      allow delete: if isTeacherOrAdmin();
    }

    // Match class projects
    match /projects/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (isTeacherOrAdmin() || resource.data.uid == request.auth.uid);
      allow delete: if isTeacherOrAdmin();
    }

    // Match Head Tilt interactive games
    match /head_tilt_games/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isTeacherOrAdmin() || (isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        !('ownerUid' in resource.data)
      ));
      allow delete: if isTeacherOrAdmin();
    }

    // Match exam configurations (exam_configs)
    match /exam_configs/{docId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin();
    }

    // Match class assignments (class_assignments)
    match /class_assignments/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }

    // Match blacklisted devices
    match /blacklisted_devices/{docId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin();
    }
  }
}
