# ============================================
# EduRobot 5.0 — Environment Variables Template
# ============================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the `.env` file to Git.

# Firebase Configuration (client-side)
# These keys are safe to expose in client-side code as they are
# restricted by Firestore Security Rules (see firestore.rules).
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# AI Tutor (Thầy E)
# The Gemini API key is managed server-side via Netlify serverless
# function (/.netlify/functions/chat). No client-side key needed.
# Set GEMINI_API_KEY in Netlify dashboard → Environment Variables.
